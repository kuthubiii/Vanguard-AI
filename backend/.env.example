
# ==========================================
# Vanguard AI - Local Development
# ==========================================

APP_ENV=development
APP_NAME=Vanguard AI
API_V1_PREFIX=/api/v1

# ==========================================
# PostgreSQL Database
# ==========================================

DATABASE_URL=postgresql+psycopg://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/vanguard_ai

# ==========================================
# Application Security
# ==========================================

SECRET_KEY=YOUR_EXISTING_APPLICATION_SECRET

# ==========================================
# JWT Authentication
# ==========================================

JWT_SECRET_KEY=PASTE_YOUR_GENERATED_JWT_SECRET_HERE
